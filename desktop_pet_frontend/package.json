{
  
  "name": "desktop-pet-scheduler",
  "version": "5.0.0",
  "private": true,
  "main": "dist-electron/main.js",
  "description": "MaiCoreStart desktop pet scheduler - Electron desktop pet app",
  "scripts": {
    "dev": "vite",
    "dev:electron": "vite build && electron .",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "@material/web": "^2.3.0",
    "lit": "^3.2.0",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^41.0.0",
    "electron-builder": "^25.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vite-plugin-node-polyfills": "^0.25.0"
  },
  "build": {
    "appId": "com.xiaocz.mcstartdesktoppet",
    "productName": "MCStart Desktop Pet",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    }
  }
}
